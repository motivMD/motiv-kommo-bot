# ─── REQUIRED ─────────────────────────────────────────────────────────────

# Anthropic Claude API key
# Obții de pe: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# Kommo CRM API key (Long-term token)
# Obții din: Kommo → Settings → Integrations → API
KOMMO_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kommo subdomeniu (ex: din "adminmotivmd.kommo.com" → pune "adminmotivmd")
KOMMO_SUBDOMAIN=adminmotivmd

# ─── RECOMANDAT (persistent storage) ──────────────────────────────────────

# Supabase URL + Anon key (free 500MB persistent)
# Obții din: https://supabase.com → New Project → Settings → API
# Dacă lipsesc, bot folosește in-memory (datele se pierd la restart Render)
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIs...

# ─── OPTIONAL ─────────────────────────────────────────────────────────────

# Parolă pentru endpoint /export (default: motiv2026)
EXPORT_PASSWORD=motiv2026

# Model Claude (default: claude-sonnet-4-20250514)
# Alternative: claude-sonnet-4-5-20250929 (mai bun, similar cost)
#              claude-opus-4-20250514 (mult mai capabil, cost 5×)
#              claude-haiku-4-5-20251001 (mai ieftin 3×, calitate redusă)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Token-uri maxime per răspuns (default: 500, suficient pentru post-sale)
CLAUDE_MAX_TOKENS=500

# Rate limiting: cât timp între răspunsuri pentru același talk_id (secunde)
RATE_LIMIT_SECONDS=60

# Câte mesaje istoric trimitem la Claude pentru context (default: 10)
MAX_HISTORY_MESSAGES=10

# Port (Render setează automat)
PORT=3000
